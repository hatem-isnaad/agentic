# ---------------------------------------------------------------------------
# Agentic package (copy into your Laravel app .env and adjust)
# ---------------------------------------------------------------------------

AGENTIC_ENABLED=true

# Default AI (Laravel AI SDK) when an agent omits provider/model
AGENTIC_AI_PROVIDER=openai
AGENTIC_AI_MODEL=gpt-4.1-mini
AGENTIC_OPENAI_MODELS=gpt-4.1-mini,gpt-4o
AGENTIC_ANTHROPIC_MODELS=claude-sonnet-4-20250514

# Permissions (deny by default recommended for production)
AGENTIC_PERMISSION_DEFAULT=deny
# AGENTIC_PERMISSION_CHECKER=Agentic\Permission\RuleBasedPermissionChecker
# AGENTIC_PERMISSION_ALLOW_PATTERNS=orders.*,crm.*
# AGENTIC_PERMISSION_DENY_PATTERNS=*.delete,secrets.*

# Tool write approval (widget + runtime)
AGENTIC_TOOL_APPROVAL_ENABLED=true
AGENTIC_TOOL_APPROVAL_PATTERNS=*.write,*.create,*.update,*.delete
AGENTIC_TOOL_APPROVAL_AUTO_EXECUTE=true
AGENTIC_TOOL_APPROVAL_AUTO_RESUME=true
# AGENTIC_TOOL_APPROVAL_RESUME_TEMPLATE="The user approved tool :tool. Result: :result. Continue the conversation naturally for the user."

# Persistence drivers: eloquent | memory
AGENTIC_EXECUTION_DRIVER=eloquent
AGENTIC_CONVERSATION_DRIVER=eloquent
AGENTIC_KNOWLEDGE_DRIVER=eloquent
AGENTIC_MEMORY_DRIVER=eloquent

# Knowledge / vectors
AGENTIC_KNOWLEDGE_EMBEDDING=null
# Production RAG (Laravel AI SDK embeddings):
# AGENTIC_KNOWLEDGE_EMBEDDING=laravel_ai
# AGENTIC_KNOWLEDGE_EMBEDDING_PROVIDER=openai
# AGENTIC_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
AGENTIC_VECTOR_STORE=array
# AGENTIC_VECTOR_STORE=pgvector
# Native PostgreSQL pgvector extension (requires Postgres + migrate):
# AGENTIC_VECTOR_STORE=postgres
# AGENTIC_PGVECTOR_DIMENSIONS=1536
# AGENTIC_VECTOR_STORE=pinecone
# AGENTIC_PINECONE_DIMENSIONS=1536
# AGENTIC_KNOWLEDGE_QUEUE_REINDEX=true
# Offline self-test: php artisan agentic:rag-validate --offline
# Live API self-test: php artisan agentic:rag-validate
PINECONE_HOST=
PINECONE_API_KEY=

AGENTIC_FALLBACK_AGENT=

# Headless admin JSON API (for your React admin SPA)
AGENTIC_ADMIN_ENABLED=true
AGENTIC_ADMIN_API_ENABLED=true
AGENTIC_ADMIN_API_PREFIX=api/agentic/admin
AGENTIC_ADMIN_WEB_ENABLED=false
AGENTIC_ADMIN_PREFIX=agentic/admin
AGENTIC_ADMIN_LOCALE=en

# Optional runtime CRUD/execute API (enable auth in production)
AGENTIC_API_ENABLED=false
AGENTIC_API_PREFIX=api/agentic
AGENTIC_API_REQUIRE_AUTH=false
AGENTIC_API_RATE_LIMIT_ENABLED=true
AGENTIC_API_RATE_LIMIT_PER_MINUTE=120

# Multi-tenant (optional; bind TenantResolver for custom logic)
# AGENTIC_TENANT_HEADER=X-Agentic-Tenant-Id

# Protect admin JSON API (requires laravel/sanctum in host app)
AGENTIC_ADMIN_REQUIRE_AUTH=false

# Optional Filament ops UI (composer require filament/filament)
AGENTIC_FILAMENT_PANELS=admin

# Embeddable chat widget API (your React widget consumes these routes)
AGENTIC_WIDGET_ENABLED=true
AGENTIC_WIDGET_PREFIX=api/agentic/widget
AGENTIC_WIDGET_AUTH_MODE=both
AGENTIC_WIDGET_ALLOW_GUEST=true
AGENTIC_WIDGET_ALLOW_AUTH=true
AGENTIC_WIDGET_MAX_CONVERSATIONS=10
AGENTIC_WIDGET_INTAKE_ENABLED=false
# AGENTIC_WIDGET_WELCOME_MESSAGE="Hello! How can we help?"
AGENTIC_WIDGET_LOCALE=en
# AGENTIC_WIDGET_AGENT_LANGUAGE=en
AGENTIC_WIDGET_THEME=light
AGENTIC_WIDGET_THEME_DIRECTION=auto

# Realtime: pusher | polling | socketio | null | websocket (stub)
AGENTIC_WIDGET_BROADCAST_DRIVER=pusher
AGENTIC_WIDGET_BROADCAST_PREFIX=agentic-widget
AGENTIC_WIDGET_BROADCAST_POLL_MS=3000
AGENTIC_WIDGET_SOCKETIO_URL=
AGENTIC_WIDGET_SOCKETIO_TOKEN=
AGENTIC_WIDGET_SOCKETIO_TIMEOUT=5

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
