{
  "name": "hatem-isnaad/agentic",
  "description": "A configuration-driven AI agent orchestration framework for Laravel, built on the Laravel AI SDK.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "laravel/ai": "^1.0",
    "illuminate/http": "^12.0|^13.0",
    "laravel/mcp": "^1.0"
  },
  "require-dev": {
    "filament/filament": "^4.0",
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0",
    "smalot/pdfparser": "^2.0",
    "laravel/sanctum": "^4.0"
  },
  "suggest": {
    "filament/filament": "Required for the optional Agentic Filament admin panel (^4.0).",
    "smalot/pdfparser": "Required for PDF knowledge ingest (format=pdf).",
    "laravel/sanctum": "Required for Agentic auth API and protected admin/runtime routes.",
    "laravel/passkeys": "Optional WebAuthn routes under /api/agentic/auth."
  },
  "autoload": {
    "psr-4": {
      "Agentic\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Agentic\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Agentic\\AgenticServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
