{
  "name": "hatem-isnaad/agentic",
  "description": "A configuration-driven AI agent orchestration framework for Laravel, built on the Laravel AI SDK.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "laravel/ai": "^1.0",
    "illuminate/http": "^12.0|^13.0",
    "laravel/mcp": "^1.0",
    "laravel/sanctum": "^4.0",
    "laravel/passkeys": "^0.2.1"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Agentic\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Agentic\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Agentic\\AgenticServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
